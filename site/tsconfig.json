{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "paths": { "@stellagate/core": ["../src/index.ts"] }
  },
  "include": ["src"]
}
