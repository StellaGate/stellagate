{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix site",
  "buildCommand": "npm run build --prefix site",
  "outputDirectory": "site/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/batch", "destination": "/batch.html" },
    { "source": "/memo", "destination": "/memo.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/playground", "destination": "/playground.html" }
  ]
}
